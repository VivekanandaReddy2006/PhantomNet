# Database Configuration
# For local development with SQLite (uses WAL mode automatically), leave DATABASE_URL blank or set to sqlite:///./phantomnet.db
# To use PostgreSQL:
DATABASE_URL=postgresql://phantomnet:password@localhost:5432/phantomnet
DB_HOST=localhost
DB_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=phantomnet


# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=False
API_LOG_LEVEL=INFO

# Frontend Configuration
REACT_APP_API_URL=http://localhost:8000
REACT_APP_ENV=development

# Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_DAYS=7

# Honeypot Ports
SSH_HONEYPOT_PORT=2222
HTTP_HONEYPOT_PORT=8080
FTP_HONEYPOT_PORT=2121

# Threat Intelligence API Keys (Register at abuseipdb.com and otx.alienvault.com)
ABUSE_IPDB_KEY=your_abuseipdb_api_key_here
ALIENVAULT_OTX_KEY=your_alienvault_otx_key_here

# Environment
ENVIRONMENT=development
TIMEZONE=UTC

# Windows Console Unicode Encoding Fix
# Force Python to use UTF-8 encoding for standard input/output/error streams.
# To ensure Windows terminals (CMD / PowerShell) do not crash on special characters,
# set this environment variable in your terminal environment before starting Uvicorn:
#   CMD: set PYTHONIOENCODING=utf-8
#   PowerShell: $env:PYTHONIOENCODING="utf-8"
PYTHONIOENCODING=utf-8

# Sentinel Playbook Generation Loop (opt-in)
# Set to true to enable automatic playbook generation from campaign clustering
SENTINEL_ENABLED=false

# Sentinel Auto-Generation Scheduler (APScheduler-based, opt-in)
# Set to true to enable periodic background playbook auto-generation
SENTINEL_AUTO_GEN_ENABLED=false
# Interval in minutes between auto-generation cycles (minimum: 1)
SENTINEL_AUTO_GEN_INTERVAL_MINUTES=30

# Sentinel LLM Configuration (opt-in)
# Set to true to enable AI-enhanced narratives inside incident playbooks
SENTINEL_LLM_ENABLED=false
# Base URL for the Ollama inference engine container (http://ollama:11434 in docker-compose, or http://localhost:11434 if run natively)
SENTINEL_LLM_HOST=http://ollama:11434
# Local LLM model name pulled inside Ollama (defaults to mistral)
SENTINEL_LLM_MODEL=mistral

# Sentinel Email Alert Notifications (opt-in)
# Set to true to enable email alerts for high-severity playbooks
SENTINEL_EMAIL_ALERTS_ENABLED=false
# SMTP server configuration
SENTINEL_EMAIL_SMTP_HOST=smtp.gmail.com
SENTINEL_EMAIL_SMTP_PORT=587
SENTINEL_EMAIL_SMTP_USER=your-email@gmail.com
SENTINEL_EMAIL_SMTP_PASSWORD=your-app-password
SENTINEL_EMAIL_SMTP_USE_TLS=true
# Sender and recipient addresses (comma-separated for multiple recipients)
SENTINEL_EMAIL_FROM_ADDRESS=sentinel@phantomnet.local
SENTINEL_EMAIL_RECIPIENTS=admin@example.com,soc-team@example.com
# Minimum severity to trigger email alerts: CRITICAL, HIGH, MEDIUM, LOW
SENTINEL_EMAIL_SEVERITY_THRESHOLD=CRITICAL
# Dashboard base URL for deep links in alert emails
SENTINEL_DASHBOARD_BASE_URL=http://localhost:3000


